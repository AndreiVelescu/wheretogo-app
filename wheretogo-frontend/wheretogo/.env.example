# Environment Configuration
EXPO_PUBLIC_ENV=development

# API Configuration - Replace with your actual IP address
EXPO_PUBLIC_API_BASE_URL_IOS=http://YOUR_IP_ADDRESS:8080
EXPO_PUBLIC_API_BASE_URL_ANDROID=http://10.0.2.2:8080
EXPO_PUBLIC_API_BASE_URL_PRODUCTION=https://your-production-api.com

# API Endpoints
EXPO_PUBLIC_API_VERSION=v1

# Timeouts (in milliseconds)
EXPO_PUBLIC_API_TIMEOUT=10000

# Storage Keys
EXPO_PUBLIC_ACCESS_TOKEN_KEY=accessToken
EXPO_PUBLIC_REFRESH_TOKEN_KEY=refreshToken
EXPO_PUBLIC_USER_KEY=user

# Google OAuth Configuration
EXPO_PUBLIC_GOOGLE_CLIENT_ID=**********-qhkgltnlf2g1kc4qmhu89a8f6c9cfg69.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_DEBUG=true

# Google API Configuration
EXPO_PUBLIC_GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# App Configuration
EXPO_PUBLIC_APP_NAME=WhereToGo
EXPO_PUBLIC_APP_VERSION=1.0.0

# Debug Settings
EXPO_PUBLIC_DEBUG_API=true
EXPO_PUBLIC_LOG_LEVEL=info

# OAuth Redirect URLs (pentru documentație)
# Development: exp://192.168.x.x:8081
# Production: wheretogo://oauth